rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // /users/{uid}
    // Users can read and write only their own document.
    // -----------------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // -----------------------------------------------------------------------
    // /config/{docId}
    // Publicly readable (contains service URLs like the ESPN proxy endpoint).
    // Not writable from the client.
    // -----------------------------------------------------------------------
    match /config/{docId} {
      allow read: if true;
    }

    // -----------------------------------------------------------------------
    // /leagues/{leagueId}
    // Platform metadata cache (demoted by #103/#110 — editor/privacy live on
    // /newsletters now). Publicly readable; any signed-in visit may seed the
    // doc; no client updates or deletes (league-doc `features` for the legacy
    // experience are console-edited until #103 ladder step 5).
    // -----------------------------------------------------------------------
    match /leagues/{leagueId} {
      allow read: if true;
      // Shape-validated: doc IDs are predictable platform IDs and updates are
      // denied, so an unvalidated create would let anyone permanently poison
      // a league's metadata/features before the legitimate auto-seed runs.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['platform', 'platformLeagueId', 'name', 'season', 'features', 'createdAt'])
        && request.resource.data.platform in ['sleeper', 'espn', 'yahoo']
        && request.resource.data.name is string
        && request.resource.data.season is int
        && request.resource.data.features is list;
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // /newsletters/{newsletterId}   (issue #103)
    // The top-level publication entity. Publicly readable (privacy gating is
    // client-side until sub-issue D). Creation is claiming: the creator must
    // name themselves editor, with no co-editors (carries forward the
    // pre-create hole fix from #102). leagueIds must stay in sync with
    // seasons — full projection equality isn't expressible in rules, so we
    // assert size equality and rely on the CRUD layer for content.
    // -----------------------------------------------------------------------
    match /newsletters/{newsletterId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.editorUid == request.auth.uid
        && request.resource.data.coEditorUids.size() == 0
        && request.resource.data.leagueIds.size() == request.resource.data.seasons.size()
        && request.resource.data.name is string
        && request.resource.data.privacy in ['public', 'league_only']
        && request.resource.data.activeLeagueId is string
        && request.resource.data.features is list;
      // Editors can update anything except the frozen fields below.
      // Co-editors can update content but never the co-editor list itself —
      // otherwise one co-editor could strip the others or mass-add strangers.
      allow update: if request.auth != null
        && (resource.data.editorUid == request.auth.uid
            || (request.auth.uid in resource.data.coEditorUids
                && request.resource.data.coEditorUids == resource.data.coEditorUids))
        // The editor role never transfers via client writes.
        && request.resource.data.editorUid == resource.data.editorUid
        // createdAt is an audit field — backdating could game any future
        // "oldest newsletter" anti-squatting heuristics.
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.privacy in ['public', 'league_only']
        && request.resource.data.leagueIds.size() == request.resource.data.seasons.size();
      allow delete: if request.auth != null
        && resource.data.editorUid == request.auth.uid;

      // ---------------------------------------------------------------------
      // /newsletters/{newsletterId}/issues/{issueId}
      // Editions. Publicly readable; writable by editor or co-editors.
      // Doc IDs must match one of the client's two conventions:
      //   weekly "{season}_w{NN}" (zero-padded for chronological sorting) or
      //   ad-hoc "{season}_x{epochMillis}" (week-less special issues).
      // ---------------------------------------------------------------------
      match /issues/{issueId} {
        allow read: if true;
        // Field validation on create/update (merged-doc semantics): even a
        // co-editor's hand-rolled client can't write a bogus status or
        // mistyped season/week — the ID↔field reconciliation beyond the
        // season prefix isn't expressible in rules and stays client-side.
        allow create, update: if request.auth != null
          && issueId.matches('^[0-9]{4}_(w[0-9]{2}|x[0-9]{10,16})$')
          && (get(/databases/$(database)/documents/newsletters/$(newsletterId)).data.editorUid == request.auth.uid
              || request.auth.uid in get(/databases/$(database)/documents/newsletters/$(newsletterId)).data.coEditorUids)
          && request.resource.data.keys().hasOnly(
               ['status', 'publishedAt', 'season', 'week', 'leagueId', 'title', 'sortWeek', 'sections'])
          && request.resource.data.status in ['draft', 'published']
          && request.resource.data.season is int
          && issueId.matches('^' + string(request.resource.data.season) + '_.*')
          && (request.resource.data.week is int || request.resource.data.week == null)
          && request.resource.data.leagueId is string
          && request.resource.data.sections is list;
        allow delete: if request.auth != null
          && (get(/databases/$(database)/documents/newsletters/$(newsletterId)).data.editorUid == request.auth.uid
              || request.auth.uid in get(/databases/$(database)/documents/newsletters/$(newsletterId)).data.coEditorUids);
      }
    }

    // -----------------------------------------------------------------------
    // /leaderboards/{docId}
    // Publicly readable. Not writable from the client (managed via console).
    // TODO: Add write rules when admin UI is built.
    // -----------------------------------------------------------------------
    match /leaderboards/{docId} {
      allow read: if true;
    }

    // -----------------------------------------------------------------------
    // /leaderboard-results/{docId}
    // Publicly readable. Anyone can submit results (no auth required per
    // current Submit modal behavior). Tighten to authenticated-only later.
    // TODO: Require auth and validate submission shape.
    // -----------------------------------------------------------------------
    match /leaderboard-results/{docId} {
      allow read: if true;
      allow create: if true;
    }

    // -----------------------------------------------------------------------
    // /leaderboard-times/{docId}
    // Publicly readable (Eaterboard page). Not writable from the client.
    // -----------------------------------------------------------------------
    match /leaderboard-times/{docId} {
      allow read: if true;
    }

    // -----------------------------------------------------------------------
    // /submissions/{docId}
    // Write-only from the client (anonymous newsletter submissions).
    // Not readable from the client — reviewed via Firebase console.
    // TODO: Require auth or rate-limit to prevent spam.
    // -----------------------------------------------------------------------
    match /submissions/{docId} {
      allow create: if true;
    }

    // -----------------------------------------------------------------------
    // /survivorPicks/{docId}
    // Publicly readable (leaderboard views). Authenticated users can create
    // and update picks. No deletes from client.
    // TODO: Restrict writes to own picks (e.g. request.resource.data.userId == request.auth.uid).
    // -----------------------------------------------------------------------
    match /survivorPicks/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // -----------------------------------------------------------------------
    // /apiCache/{docId}
    // Persistent cache for fantasy platform API responses (Sleeper, ESPN,
    // Yahoo) to avoid rate limiting and reduce latency.
    // Doc IDs: "{leagueId}:league", "{leagueId}:users", "{leagueId}:rosters",
    //          "{leagueId}:matchups:{week}", "{leagueId}:transactions:{leg}",
    //          "{leagueId}:winners_bracket", "{leagueId}:losers_bracket"
    // League IDs are platform-prefixed (e.g. "espn_123"), so there are no
    // cross-platform collisions. Publicly readable (league data is public on
    // all platforms). Any signed-in user can create/update — data is derived
    // from public APIs and the cache is self-healing (stale or missing
    // entries are re-fetched).
    // -----------------------------------------------------------------------
    match /apiCache/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }
  }
}
